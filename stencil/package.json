{
  "name": "akimbocomics-stencil",
  "private": true,
  "version": "0.0.0",
  "description": "Stencil app that prerenders akimbocomics.com as static HTML (milestone 0 spike).",
  "scripts": {
    "extract": "python3 scripts/extract-content.py",
    "content": "node scripts/bundle-content.mjs",
    "build": "npm run content && stencil build --prerender",
    "verify": "node scripts/verify-spike.mjs"
  },
  "devDependencies": {
    "@stencil/core": "4.45.1"
  }
}
